[Unit]
Description=MT4 Trading Monitor V1 - Wi-Fi setup hotspot when offline
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# Root is needed to change Wi-Fi (NetworkManager) and the port-80 redirect on the hotspot.
User=root
EnvironmentFile=/etc/mt4-monitor.env
ExecStart=/usr/bin/python3 /opt/mt4-monitor/wifi_setup.py
Restart=always
RestartSec=5
RuntimeDirectory=mt4-wifi
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
