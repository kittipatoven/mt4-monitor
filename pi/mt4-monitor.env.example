# Copy to /etc/mt4-monitor.env  (sudo chmod 600, owner root)
# Generate a key:  python3 -c "import secrets; print(secrets.token_hex(16))"
MT4MON_API_KEY=CHANGE_ME
MT4MON_HOST=0.0.0.0
# MT4 WebRequest only allows ports 80/443
MT4MON_PORT=80
MT4MON_LCD_ENABLED=1
MT4MON_I2C_BUS=1
# Use the address shown by: sudo i2cdetect -y 1   (usually 0x27 or 0x3F)
MT4MON_LCD_ADDRESS=0x27
MT4MON_PAGE_SECONDS=3
MT4MON_STALE_SECONDS=30
MT4MON_MAX_ORDER_PAGES=5
MT4MON_HOME_SECONDS=8
# Alert (blink backlight) when floating loss >= this % of balance. 0 = off
MT4MON_DD_ALERT_PCT=2.0
# Backlight off between these hours, e.g. 23 and 7 (alerts still blink). -1 = always on
MT4MON_NIGHT_START=-1
MT4MON_NIGHT_END=7
# 1 = one fixed page + alert pages, 0 = rotate through all pages
MT4MON_SINGLE_PAGE=1
# Seconds per page in that mode: big P/L digits; 1-hour equity sparkline (0 = off, e.g. 4 = on)
MT4MON_BIG_SECONDS=6
MT4MON_SPARK_SECONDS=0
# Wi-Fi setup: with no network for MT4MON_SETUP_AFTER seconds the Pi opens its own
# hotspot (MT4-Setup-XXXX) and a setup page to pick a Wi-Fi. 0 = off
MT4MON_WIFI_SETUP=1
MT4MON_SETUP_AFTER=90
# Hotspot password: random = a new 8-digit one each time setup mode opens (shown on
# the LCD). Or set your own fixed password (8-63 characters).
MT4MON_SETUP_PASS=random
# Screen: lcd1602 = 16x2 I2C LCD, tft35 = 3.5in 480x320 colour SPI touch screen
MT4MON_DISPLAY=lcd1602
