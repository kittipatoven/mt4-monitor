[Unit]
Description=MT4 Trading Monitor V1 (LCD + API, read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mt4mon
Group=mt4mon
SupplementaryGroups=i2c video input
WorkingDirectory=/opt/mt4-monitor
EnvironmentFile=/etc/mt4-monitor.env
ExecStart=/opt/mt4-monitor/venv/bin/python /opt/mt4-monitor/main.py
Restart=always
RestartSec=5
# MT4 WebRequest only allows ports 80/443, so the API listens on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
